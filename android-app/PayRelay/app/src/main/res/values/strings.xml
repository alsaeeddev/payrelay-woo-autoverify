    <string name="consent_title">Payment SMS Privacy Notice</string>
    <string name="consent_subtitle">PayRelay forwards only verified payment alerts to your own WordPress store.</string>
    <string name="consent_point_allowlist_title">Strict Sender Allowlist</string>
    <string name="consent_point_allowlist_desc">Only SMS from allowlisted wallets and banks (such as JazzCash, Easypaisa, and Pakistani banks) are processed. Personal messages and OTPs are dropped immediately and never stored or logged.</string>
    <string name="consent_point_security_title">Encrypted &amp; Signed</string>
    <string name="consent_point_security_desc">Your pairing secret is encrypted with Android Keystore, transmitted over HTTPS only, and every payload is signed with HMAC-SHA256.</string>
